{
  "name": "leitstelle-112",
  "private": true,
  "version": "0.1.0",
  "description": "Realistischer Leitstellensimulator für Rettungsdienst, Feuerwehr und Katastrophenschutz",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ls112/desktop dev",
    "build": "pnpm --filter @ls112/ui build && pnpm --filter @ls112/desktop build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "e2e": "playwright test",
    "package": "pnpm build && pnpm --filter @ls112/desktop package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
