{
  "name": "@ls112/region-builder",
  "version": "1.1.0",
  "private": true,
  "description": "Erzeugt Regionspakete für Leitstelle 112 aus OpenStreetMap-Daten (ADR-0020)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs --log-level=warning",
    "region": "pnpm run build && node dist/cli.mjs"
  },
  "dependencies": {
    "@ls112/content": "workspace:*",
    "@ls112/routing": "workspace:*"
  },
  "devDependencies": {
    "@ls112/sim": "workspace:*"
  }
}
